# Copy this file to backend/.env and fill in your own values. Never commit .env.
# Generate JOURNAL_KEY once per environment:
#   .\.venv\Scripts\python.exe -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

APP_ENV=development
# Development database (the application user, not the postgres superuser).
# Put special characters in the password as URL escapes: @ becomes %40.
DATABASE_URL=postgresql+psycopg://mindbridge_app:CHANGE_ME@127.0.0.1:5432/mindbridge_dev
# Test database, used only by pytest and the end-to-end tests (name must contain mindbridge_test).
TEST_DATABASE_URL=postgresql+psycopg://mindbridge_app:CHANGE_ME@127.0.0.1:5432/mindbridge_test

FRONTEND_ORIGIN=http://localhost:3000
JOURNAL_KEY=GENERATE_A_FERNET_KEY_SEE_COMMENT_ABOVE

# Sessions: a user is logged out after this many idle minutes, or after this many hours in total.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
# Set to true when the site is served over HTTPS (production).
COOKIE_SECURE=false

# Development only: write password reset links to the server log (no email service is configured).
LOG_PASSWORD_RESET_LINKS=true
RATE_LIMIT_PER_MINUTE=10

# Development seed data only (python scripts/seed_demo.py). Choose your own values.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_PASSWORD=CHANGE_ME
